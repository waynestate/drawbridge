<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="false"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <!-- Plain `phpunit` (and the PREFLIGHT php-test job) run only this: no Docker, no network.
             The container rig has its own config, phpunit.e2e.xml.dist. -->
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
