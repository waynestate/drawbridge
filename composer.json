{
    "name": "waynestate/drawbridge",
    "description": "The Citadel auth gateway: header policy, per-app path rules and a signed assertion signer for an Apache + mod_auth_openidc front door to Microsoft Entra ID.",
    "homepage": "https://drawbridge.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/drawbridge"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "lcobucci/jwt": "^5.6",
        "psr/clock": "^1.0",
        "symfony/console": "^7.1",
        "symfony/yaml": "^7.1",
        "promphp/prometheus_client_php": "^2.15"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.1",
        "symfony/css-selector": "^7.1",
        "symfony/dom-crawler": "^7.1",
        "symfony/http-client": "^7.1",
        "symfony/mime": "^7.1",
        "waynestate/pinstripe": "^0.1"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "site:agent-ready": "php bin/agent-ready.php",
        "site:agent-ready-check": "php bin/agent-ready.php --check",
        "ci": [
            "@composer validate --strict",
            "phpunit",
            "pint --test",
            "@site:agent-ready-check",
            "phpstan analyse --memory-limit=1G",
            "@composer audit"
        ]
    },
    "scripts-descriptions": {
        "ci": "Run every CI check: manifest, unit tests, style, agent-ready files, static analysis, audit. The container rig has its own script (rig/run.sh or rig/run.ps1).",
        "site:agent-ready": "Rewrite the Markdown twins, llms.txt, llms-full.txt, robots.txt and sitemap.xml in site/ (Squire's agent-ready kit).",
        "site:agent-ready-check": "Fail when the agent-ready files are stale, a page lacks its Markdown link, a prompt drifts from the docs, or the kit was edited here."
    },
    "bin": [
        "bin/drawbridge"
    ],
    "autoload": {
        "psr-4": {
            "Waynestate\\Drawbridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Drawbridge\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
