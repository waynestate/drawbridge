{
    "name": "waynestate/drawbridge",
    "description": "The Citadel auth gateway: header policy, per-app path rules and a signed assertion signer for an Apache + mod_auth_openidc front door to Microsoft Entra ID.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "lcobucci/jwt": "^5.6",
        "psr/clock": "^1.0",
        "symfony/console": "^7.1",
        "symfony/yaml": "^7.1"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.1",
        "symfony/css-selector": "^7.1",
        "symfony/dom-crawler": "^7.1",
        "symfony/http-client": "^7.1",
        "symfony/mime": "^7.1"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "ci": [
            "@composer validate --strict",
            "phpunit",
            "pint --test",
            "phpstan analyse --memory-limit=1G",
            "@composer audit"
        ]
    },
    "scripts-descriptions": {
        "ci": "Run every CI check: manifest, unit tests, style, static analysis, audit. The container rig has its own script (rig/run.sh or rig/run.ps1)."
    },
    "bin": [
        "bin/drawbridge"
    ],
    "autoload": {
        "psr-4": {
            "Waynestate\\Drawbridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Drawbridge\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
