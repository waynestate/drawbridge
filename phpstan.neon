# PHPStan settings come from Pinstripe (the stack's coding standard), raw PHP cut.
# This file adds only Drawbridge's own paths and PHP version range.
includes:
    - vendor/waynestate/pinstripe/phpstan/raw.neon

parameters:
    paths:
        - src
        - bin/drawbridge
        - bin/metrics
    phpVersion:
        min: 80300
        max: 80599
