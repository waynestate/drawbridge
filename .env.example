# DRAWBRIDGE settings. Copy to .env and fill in; every value below is a placeholder, not a secret.
# Real keys, certificates and IdP metadata are files mounted into the container, never values in git.

# Where the per-app config lives (see config/drawbridge.example.yaml).
DRAWBRIDGE_CONFIG=/etc/drawbridge/drawbridge.yaml

# Port Apache listens on inside the container (non-root, so above 1024).
DRAWBRIDGE_PORT=8080

# How browsers reach the gateway. Used for ServerName, X-Forwarded-* and SP metadata.
DRAWBRIDGE_PUBLIC_SCHEME=https
# Leave empty for the scheme default (443 / 80). Set it only for a non-standard public port.
DRAWBRIDGE_PUBLIC_PORT=

# Secure, __Host- style session cookies. Keep true everywhere except a plain-HTTP local rig.
DRAWBRIDGE_COOKIE_SECURE=true

# Comma-separated CIDRs of load balancers allowed to set X-Forwarded-For. Empty means trust nobody.
DRAWBRIDGE_TRUSTED_PROXIES=

# Files (mounted, not baked in).
DRAWBRIDGE_IDP_METADATA_FILE=/run/drawbridge/idp-metadata.xml
DRAWBRIDGE_SP_KEY_FILE=/run/drawbridge/sp.key
DRAWBRIDGE_SP_CERT_FILE=/run/drawbridge/sp.crt
DRAWBRIDGE_SIGNING_KEY_FILE=/run/drawbridge/signing.key

# Key id written into every assertion header. Change it when you rotate the signing key.
DRAWBRIDGE_SIGNING_KEY_ID=drawbridge-1

# How many sessions the in-memory cache holds (minimum 10).
DRAWBRIDGE_SESSION_CACHE_ENTRIES=1000

# Scratch space for rendered config, locks and the session cache. Needs to be writable by the container user.
DRAWBRIDGE_RUN_DIR=/tmp/drawbridge

# Apache log level: debug, info, notice, warn, error.
DRAWBRIDGE_LOG_LEVEL=warn
