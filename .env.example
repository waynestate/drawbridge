# DRAWBRIDGE settings. Copy to .env and fill in; every value below is a placeholder, not a secret.
# Real secrets are set in the deployment's secret store (or a .env that never goes in git), and the signing key is a
# file mounted into the container.

# Where the per-app config lives (see config/drawbridge.example.yaml).
DRAWBRIDGE_CONFIG=/etc/drawbridge/drawbridge.yaml

# Port Apache listens on inside the container (non-root, so above 1024).
DRAWBRIDGE_PORT=8080

# How browsers reach the gateway. Used for ServerName, X-Forwarded-* and the OpenID Connect redirect URI.
DRAWBRIDGE_PUBLIC_SCHEME=https
# Leave empty for the scheme default (443 / 80). Set it only for a non-standard public port.
DRAWBRIDGE_PUBLIC_PORT=

# Secure, __Host- style session cookies. Keep true everywhere except a plain-HTTP local rig.
DRAWBRIDGE_COOKIE_SECURE=true

# Comma-separated CIDRs of load balancers allowed to set X-Forwarded-For. Empty means trust nobody.
DRAWBRIDGE_TRUSTED_PROXIES=

# The Entra app registration's client secret. The variable's NAME is oidc.client_secret_env in drawbridge.yaml.
# No spaces, quotes or backslashes (Entra's generated secrets have none). The container will not start without it.
DRAWBRIDGE_OIDC_CLIENT_SECRET=

# mod_auth_openidc's crypto passphrase: encrypts the state cookie and the session cache. At least 32 characters, no
# spaces, quotes or backslashes; make one with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Changing it signs everyone out. The container will not start without it.
DRAWBRIDGE_OIDC_CRYPTO_PASSPHRASE=

# The assertion signing key (mounted, not baked in).
DRAWBRIDGE_SIGNING_KEY_FILE=/run/drawbridge/signing.key

# Key id written into every assertion header. Change it when you rotate the signing key.
DRAWBRIDGE_SIGNING_KEY_ID=drawbridge-1

# Entries in the shared-memory cache (sessions, plus nonces, provider metadata and keys; minimum 10).
DRAWBRIDGE_SESSION_CACHE_ENTRIES=1000

# Scratch space for rendered config, locks and the session cache. Needs to be writable by the container user.
DRAWBRIDGE_RUN_DIR=/tmp/drawbridge

# Apache log level: debug, info, notice, warn, error.
DRAWBRIDGE_LOG_LEVEL=warn

# The /metrics endpoint is off unless one of these is set.
# Bearer token that may read /metrics (Authorization: Bearer <token>). Empty turns the endpoint off unless an
# allow list is set.
DRAWBRIDGE_METRICS_TOKEN=
# Comma list of client IPs/CIDRs allowed to read /metrics (matched against the real client address, never a
# client-supplied header). Empty trusts no address.
DRAWBRIDGE_METRICS_ALLOW=
